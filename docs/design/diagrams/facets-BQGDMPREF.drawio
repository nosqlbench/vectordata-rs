        <mxCell id="pairbox" value="Pairing at the junctions: the standard scheme sets |P| = |Q|, and ordinal i means ⟨query i, predicate i⟩ — so G, D, R (paired view), F, and E are all row-aligned on the same i." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="540" height="52" as="geometry" />
        </mxCell>
        <mxCell id="obox" value="O — oracle partitions (companion construct): profiles/label_NN/ re-materialize B/Q/G/D per label value, each in its own ordinal space. A profile-level construct, not a facet file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="580" width="530" height="52" as="geometry" />
