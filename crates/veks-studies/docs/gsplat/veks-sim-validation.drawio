        <mxCell id="hdr2" value="A SECOND, INDEPENDENT AXIS — the block scheduler" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pub2" value="&lt;b&gt;Published&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Ren et al. ICPE '24, Samsung NVMe&#xa;mq-deadline 569.2k · bfq 315.3k IOPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="sim2" value="&lt;b&gt;Simulated&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;4 KiB random, depth 512, 16 cores&#xa;mq-deadline 567k · bfq 315k IOPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="730" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="ver2" value="&lt;b&gt;Difference&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;−0.4% and −0.2%, with the&#xa;scheduler lock at 100% busy in both&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="730" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n_axis2" value="Nothing here was fitted from the fio corpus: a different source, a different&#xa;quantity, a different mechanism. The ceiling is modelled as a serialized lock,&#xa;so it does not move when cores are added — which is the observation that&#xa;told the paper's authors it was contention rather than CPU cost per request." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="960" y="730" width="440" height="80" as="geometry" />
        </mxCell>
