        <mxCell id="v7" value="replayed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontSize=11;dashed=1;verticalAlign=bottom;" edge="1" parent="1" source="w3" target="sim">
