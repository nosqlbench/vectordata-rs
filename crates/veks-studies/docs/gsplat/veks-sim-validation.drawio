<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="validation">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="veks-studies — how the storage model is judged" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The same workload is run twice — once on hardware, once in the simulator — and the two are differenced. Twice over, against two unrelated sources." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="corpus" value="&lt;b&gt;perfscripts fio corpus&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;direct=1 · libaio · iodepth=10&#xa;60 s · 3 devices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;random read&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;512 B – 16 MiB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="160" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;sequential&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;read and write, 1 MiB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;mixed&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;reader vs capped writer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="meas" value="&lt;b&gt;Measured&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;IOPS · bandwidth&#xa;clat percentiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;Simulated&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;same workload, same depth&#xa;against the modelled device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="diff" value="&lt;b&gt;Difference, per metric&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;MAPE · worst case · signed bias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bars" value="&lt;b&gt;Published bars&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;MQSim 6–18%&#xa;SimpleSSD 28% / 36%&#xa;generative 4–10% / 3–16%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="130" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="verdict" value="&lt;b&gt;Achieved&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;read throughput 3.9% · mean latency 4.4%&#xa;worst-case throughput 14.6% · worst p99 33.2%&#xa;sequential write 4.3%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="470" width="290" height="86" as="geometry" />
        </mxCell>

        <mxCell id="n_bias" value="Signed bias is the diagnostic one.&#xa;Scatter means imprecision; a&#xa;consistent sign means a missing&#xa;term. Two mechanisms were found&#xa;exactly this way." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1190" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_depth" value="Everything downstream of this&#xa;corpus is a claim about&#xa;iodepth=10 on 2016 hardware." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_fit" value="Fitted: device rates, ceilings, page-type spread,&#xa;rotational selection accuracy, write ceilings.&#xa;Predicted: sequential throughput, distribution&#xa;shape across block sizes, contention direction." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="480" height="80" as="geometry" />
        </mxCell>

