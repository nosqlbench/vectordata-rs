<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="staged-dataflow">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="gsplat staged — one sweep of the source, whatever the segment count" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The re-scan form sweeps the source once per destination segment, so its cost grows with payload/M. Spilling into RAM-sized buckets removes the re-read: the payload crosses scratch once each way and nothing is ever read twice." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1380" height="20" as="geometry" />
        </mxCell>

        <mxCell id="stage1" value="STAGE 1 — DISTRIBUTE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="102" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="STAGE 2 — TRANSFER" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="800" y="102" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="memband" value="MEMORY — bounded by the budget M" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="stoband" value="STORAGE — the tier that punishes random access" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="memlane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5fbf4;strokeColor=#c9e3c5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="1380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stolane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf2;strokeColor=#f0dcc0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="buck" value="&lt;b&gt;Bucket buffers&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;f = M / W of them, one container each.&#xa;A record goes to the buffer for the&#xa;segment its destination falls in.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="186" width="280" height="106" as="geometry" />
        </mxCell>
        <mxCell id="xform" value="&lt;b&gt;Closed transform&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;d = f(s), computed per record.&#xa;No inverse table is resident, so nothing&#xa;in memory scales with the ordinal count.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="186" width="290" height="106" as="geometry" />
        </mxCell>
        <mxCell id="seg" value="&lt;b&gt;Segment buffer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;S × R bytes — one bucket, which fits&#xa;by construction. The permutation happens&#xa;here, in memory, and nowhere else.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="810" y="186" width="300" height="106" as="geometry" />
        </mxCell>

        <mxCell id="src" value="&lt;b&gt;Source records&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;N × R, in ordinal order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="spill" value="&lt;b&gt;Spill extent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;one region per bucket. Each is appended&#xa;a container at a time and read back&#xa;straight through — sequential both ways.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Output records&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;N × R, in destination order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="470" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="banner" value="monotone reads  ·  container-sized appends  ·  contiguous writes  ·  never a backward seek, on either side, in either stage" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1380" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n_stages" value="&lt;b&gt;Why one stage is nearly always enough.&lt;/b&gt;  A bucket is only worth having if its spill writes are large enough not to seek, so each costs a container-sized buffer and&#xa;f = M/W is how many a single sweep can keep open. With a 32 GiB budget and 128 KiB containers f is a quarter of a million — a terabyte needs 32 buckets and a&#xa;petabyte 32,768, both far inside it. When the segment count does exceed f the split recurses, for ⌈log_f(segments)⌉ stages; growth is logarithmic in how badly&#xa;memory is oversubscribed, and the base is enormous." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="1380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_cost" value="&lt;b&gt;What it costs.&lt;/b&gt;  2·(stages + 1) sequential passes over the payload, independent of the segment count — against the re-scan form's A(P) + 1, which is not. The two are&#xa;level at four segments: below that the re-scan is genuinely cheaper because it never touches scratch, and above it the gap has no upper end. This is the external&#xa;distribution sort of Aggarwal &amp; Vitter's I/O model (Commun. ACM 31(9), 1988); the log_f here is their log_(M/B)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="726" width="1380" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;A₁&lt;/b&gt; — sweep the source once, ascending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontSize=11;fontColor=#6c8ebf;verticalAlign=middle;align=left;labelPosition=right;spacingLeft=8;" edge="1" parent="1" source="src" target="buck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;T₁&lt;/b&gt; — flush a full buffer:&#xa;one sequential append per bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontSize=11;fontColor=#6c8ebf;verticalAlign=bottom;" edge="1" parent="1" source="buck" target="spill">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="239" />
              <mxPoint x="390" y="380" />
              <mxPoint x="575" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;A₂&lt;/b&gt; — read one bucket straight through&#xa;(repeated for each of them)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;verticalAlign=bottom;" edge="1" parent="1" source="spill" target="seg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="765" y="515" />
              <mxPoint x="765" y="380" />
              <mxPoint x="960" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;T₂&lt;/b&gt; — permute in memory,&#xa;then one contiguous write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;verticalAlign=bottom;" edge="1" parent="1" source="seg" target="out">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="239" />
              <mxPoint x="1160" y="380" />
              <mxPoint x="1280" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d5" value="per record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;dashed=1;fontSize=11;fontColor=#82b366;" edge="1" parent="1" source="xform" target="buck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
