        <mxCell id="lbl_hit" value="hit — never&#xa;reaches the&#xa;device" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lbl_ack" value="a write is acknowledged once&#xa;it is buffered, while its dies&#xa;keep programming" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="950" y="1180" width="230" height="60" as="geometry" />
        </mxCell>
      </root>
