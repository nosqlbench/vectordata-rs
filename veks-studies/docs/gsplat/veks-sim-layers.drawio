      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="veks-studies — two models, joined by a trace" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The algorithm model never touches a device. The storage model never knows which algorithm produced its work." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="hdr_a" value="ALGORITHM MODEL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hdr_b" value="STORAGE MODEL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hdr_c" value="EVIDENCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="110" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="geom" value="&lt;b&gt;Geometry + Map&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;records, record bytes,&#xa;container bytes, a permutation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="algo" value="&lt;b&gt;Rewrite&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;gsplat · naive gather · naive scatter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;Trace&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;every read, scatter and write&#xa;as a virtual operation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;Invariant checks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;read once · monotone · single write&#xa;bounded memory · deterministic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="amp" value="&lt;b&gt;Amplification sweep&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;measured A against the formula&#xa;A(P) = P·(1 − e&lt;sup&gt;−w/P&lt;/sup&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="path" value="&lt;b&gt;Discrete-event storage path&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;host CPU · page cache · readahead&#xa;scheduler · queue · controller · dies&#xa;positioning · transfer · programming&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hw" value="&lt;b&gt;Hardware&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;geometry, rates, ceilings, dies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="125" height="80" as="geometry" />
