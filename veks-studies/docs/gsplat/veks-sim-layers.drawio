        <mxCell id="plat" value="&lt;b&gt;Platform&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;cores · memory&#xa;PCIe share · NUMA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="805" y="150" width="125" height="80" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Time, and where it went&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;IOPS · bandwidth utilization&#xa;positioning fraction · latency histogram&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="480" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fio" value="&lt;b&gt;perfscripts fio corpus&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;3 devices · 512 B–16 MiB&#xa;random, sequential, mixed&#xa;IOPS, bandwidth, clat percentiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="150" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="regime" value="&lt;b&gt;Regimes&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;measurement transcribed in&#xa;the units fio reported it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="290" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;Scorecard&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;MAPE, worst case and signed bias&#xa;per metric, against published bars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="540" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note_sep" value="The trace is the seam. An algorithm cannot see a device, and a device&#xa;cannot see an algorithm — so a change to one cannot quietly alter the other." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="560" height="50" as="geometry" />
        </mxCell>
